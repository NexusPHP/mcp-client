{
    "name": "nexusphp/mcp-client",
    "description": "PHP SDK for the MCP specification - client component.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "John Paul E. Balandan, CPA",
            "email": "paulbalandan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "amphp/amp": "^3.1",
        "amphp/byte-stream": "^2.1",
        "amphp/http-client": "^5.0",
        "amphp/process": "^2.0",
        "nexusphp/assert": "^1.0",
        "nexusphp/mcp-core": "self.version",
        "psr/log": "^3.0",
        "revolt/event-loop": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Mcp\\Client\\": ""
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
